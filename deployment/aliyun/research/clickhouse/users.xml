<clickhouse>
  <profiles>
    <monday_writer>
      <max_threads>1</max_threads>
      <max_memory_usage>1073741824</max_memory_usage>
      <max_memory_usage_for_user>2147483648</max_memory_usage_for_user>
      <max_concurrent_queries_for_user>2</max_concurrent_queries_for_user>
      <max_execution_time>120</max_execution_time>
      <log_queries>0</log_queries>
    </monday_writer>
    <monday_reader>
      <readonly>2</readonly>
      <max_threads>1</max_threads>
      <max_memory_usage>536870912</max_memory_usage>
      <max_memory_usage_for_user>2147483648</max_memory_usage_for_user>
      <max_concurrent_queries_for_user>4</max_concurrent_queries_for_user>
      <max_execution_time>60</max_execution_time>
      <log_queries>0</log_queries>
      <constraints>
        <readonly><const/></readonly>
        <max_threads><min>1</min><max>1</max></max_threads>
        <max_memory_usage><min>1</min><max>536870912</max></max_memory_usage>
        <max_memory_usage_for_user><min>1</min><max>2147483648</max></max_memory_usage_for_user>
        <max_concurrent_queries_for_user><min>1</min><max>4</max></max_concurrent_queries_for_user>
        <max_execution_time><min>1</min><max>60</max></max_execution_time>
      </constraints>
    </monday_reader>
  </profiles>
  <users>
    <default remove="1"/>
    <monday_admin>
      <password from_env="MONDAY_CLICKHOUSE_ADMIN_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
    </monday_admin>
    <monday_writer>
      <password from_env="MONDAY_CLICKHOUSE_WRITER_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>monday_writer</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT, INSERT ON monday_analytics.*</query>
      </grants>
    </monday_writer>
    <monday_reader>
      <password from_env="MONDAY_CLICKHOUSE_READER_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>monday_reader</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT ON monday_analytics.cex_market_feature_frames</query>
        <query>GRANT SELECT ON monday_analytics.cex_market_datasets</query>
      </grants>
    </monday_reader>
    <monday_task_reader>
      <password from_env="MONDAY_CLICKHOUSE_TASK_PASSWORD"/>
      <networks><ip>::/0</ip></networks>
      <profile>monday_reader</profile>
      <quota>default</quota>
      <grants>
        <query>GRANT SELECT ON monday_analytics.cex_market_feature_frames</query>
        <query>GRANT SELECT ON monday_analytics.cex_market_target_frames</query>
        <query>GRANT SELECT ON monday_analytics.cex_market_datasets</query>
      </grants>
    </monday_task_reader>
  </users>
</clickhouse>
