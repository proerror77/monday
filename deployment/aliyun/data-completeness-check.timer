[Unit]
Description=Reconcile expected vs actual OSS hour partitions every hour

[Timer]
OnBootSec=5min
# The slowest hourly lane upload sweep lands at :23, so run mid-hour; in-flight
# LOB triplets in the current hour remain excluded by the grace contract.
OnCalendar=*-*-* *:35:00
Persistent=true
Unit=data-completeness-check.service

[Install]
WantedBy=timers.target
