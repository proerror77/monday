# Shared Infrastructure Environment Configuration
# ==============================================

# Network Configuration
HFT_NETWORK=loop-engineer

# Database Configuration
CLICKHOUSE_VERSION=latest
CLICKHOUSE_USER=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=hft_db
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis Configuration
REDIS_VERSION=latest
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_MEMORY_POLICY=allkeys-lru

# Monitoring Configuration
PROMETHEUS_VERSION=latest
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_VERSION=latest
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Volume Names
CLICKHOUSE_VOLUME=clickhouse-data
REDIS_VOLUME=redis-data
PROMETHEUS_VOLUME=prometheus-data
GRAFANA_VOLUME=grafana-data
ML_MODELS_VOLUME=ml-models

# Security
ALLOW_ANONYMOUS_LOGIN=false
ENABLE_TLS=false
