# HFT系統統一環境配置文件
# ================================
# 用於 docker-compose.unified.yml 的環境變量配置

# =================== 基礎設施配置 ===================
# Redis配置
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_MEMORY_POLICY=allkeys-lru
REDIS_VOLUME=redis-data

# ClickHouse配置
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_DB=hft_db
CLICKHOUSE_VOLUME=clickhouse-data

# PostgreSQL配置
POSTGRES_PORT=5432
POSTGRES_DB=loop_engineer
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VOLUME=postgres-data

# Prometheus配置
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_VOLUME=prometheus-data

# Grafana配置
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_VOLUME=grafana-data

# =================== 應用層配置 ===================
# Rust HFT核心
GRPC_PORT=50051
RUST_METRICS_PORT=9091
RUST_HTTP_PORT=8080
RUST_LOG=info
HFT_MAX_SYMBOLS=128

# Ops Workspace (L2)
OPS_STREAMLIT_PORT=8502
OPS_API_PORT=8102

# ML Workspace (L3)
ML_STREAMLIT_PORT=8503
ML_API_PORT=8103

# Master Workspace
MASTER_STREAMLIT_PORT=8501
MASTER_API_PORT=8101

# =================== 共享存儲配置 ===================
ML_MODELS_VOLUME=ml-models

# =================== 本地Ollama配置 ===================
# 注意：確保本地Ollama在 localhost:11434 運行
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_TIMEOUT=120
