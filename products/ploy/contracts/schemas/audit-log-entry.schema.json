{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditLogEntry",
  "type": "object",
  "required": [
    "auth_level",
    "method",
    "outcome",
    "path",
    "required_access",
    "status_code",
    "timestamp"
  ],
  "properties": {
    "auth_level": {
      "type": "string"
    },
    "client_addr": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "required_access": {
      "type": "string"
    },
    "status_code": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
