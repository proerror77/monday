.git
.github
.worktrees
**/target

# Never send local Python caches or virtual environments to a Rust image build.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/

# Local credentials and key material
**/.env
**/.env.local
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
config/.env.shared
config/.env.unified
rust_hft/config/secrets.yaml
rust_hft/clickhouse_credentials.txt
