#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
shift || true

case "$cmd" in
  status|logs) ;;
  ""|-h|--help|help)
    echo "Usage: ployctl status|logs" >&2
    exit 2
    ;;
  *)
    echo "PLOY remote control mutations are disabled in Monday: $cmd" >&2
    exit 3
    ;;
esac

host="${PLOY_TRADING_HOST:-}"
if [[ -z "$host" ]]; then
  echo "PLOY_TRADING_HOST is required (example: ploy@1.2.3.4)" >&2
  exit 2
fi

ssh_opts=()
if [[ -n "${PLOY_TRADING_SSH_OPTS:-}" ]]; then
  # shellcheck disable=SC2206
  ssh_opts+=(${PLOY_TRADING_SSH_OPTS})
fi

exec ssh "${ssh_opts[@]}" "$host" "$cmd" "$@"
