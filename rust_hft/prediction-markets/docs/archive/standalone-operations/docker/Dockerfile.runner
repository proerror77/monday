# Historical standalone runtime image for ploy-runner (ployd + strategy).
# Provenance only; this is not a Monday deployment entrypoint.
# Binary is built by CI and copied in at build time
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -m -s /bin/bash ploy && \
    mkdir -p /opt/ploy/{bin,config/strategies,data,logs,run} && \
    chown -R ploy:ploy /opt/ploy

# Binary copied by CI pipeline
COPY --chown=ploy:ploy target/x86_64-unknown-linux-gnu/release/new-ploy-runner /opt/ploy/bin/ploy-runner
RUN chmod +x /opt/ploy/bin/ploy-runner

WORKDIR /opt/ploy
USER ploy

ENV RUST_LOG=info,ploy=debug,sqlx=warn

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

ENTRYPOINT ["/opt/ploy/bin/ploy-runner"]
