# Historical standalone runtime image for the Rust market-data collectors.
# Provenance only; this is not a Monday deployment entrypoint.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -m -s /usr/sbin/nologin ploy && \
    mkdir -p /opt/ploy/bin && \
    chown -R ploy:ploy /opt/ploy

COPY --chown=ploy:ploy target/x86_64-unknown-linux-gnu/release/new-ploy-runner /opt/ploy/bin/ploy-runner
RUN chmod +x /opt/ploy/bin/ploy-runner

WORKDIR /opt/ploy
USER ploy

ENV RUST_LOG=info,ploy=debug,sqlx=warn
ENTRYPOINT ["/opt/ploy/bin/ploy-runner"]
CMD ["--help"]
