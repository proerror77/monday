# Ignore build artifacts
target/
**/target/

# Ignore version control
.git/
.gitignore

# Ignore temporary files
*.swp
*.swo
*~
*.tmp

# Ignore Python artifacts produced by editors or third-party tooling. Python is
# not part of the Rust runtime image.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/venv/

# Ignore IDE files
.vscode/
.idea/
*.iml

# Ignore documentation
docs/
*.md

# Ignore test data
test-data/
**/tests/

# Keep examples Cargo.toml for workspace build
examples/*
!examples/Cargo.toml

# Ignore benchmarks
benches/

# Ignore local environment files
.env
.env.local
.env.*
!.env.example
!.env.sample
!.env.*.example
config/secrets.yaml
clickhouse_credentials.txt
*.pem
*.key
*.p12
*.pfx
*.crt

# Ignore macOS files
.DS_Store

# Ignore node modules (if any)
node_modules/

# Ignore logs
*.log

# Ignore ops folder except Dockerfile
ops/*
!ops/hft-live.Dockerfile
