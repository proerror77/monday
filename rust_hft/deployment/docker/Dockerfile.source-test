# syntax=docker/dockerfile:1.7

FROM rust:1.98-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS source-test

ARG SOURCE_REVISION
WORKDIR /work
ENV RUST_MIN_STACK=33554432 \
    CARGO_HOME=/opt/monday-source-test-cargo \
    CARGO_TARGET_DIR=/tmp/monday-source-test-target

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    cmake \
    mold \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 research \
    && useradd --create-home --uid 1000 --gid 1000 research

COPY --chown=research:research source/rust_hft/ /work/
RUN cargo fetch --locked && chown -R research:research "$CARGO_HOME"

ENV CARGO_NET_OFFLINE=true

COPY --chmod=0755 rust_hft/deployment/docker/source-test-entrypoint.sh /usr/local/bin/monday-source-test

LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.title="monday-research-source-test" \
      com.monday.image.purpose="non-production-source-test"

USER 1000:1000
ENTRYPOINT ["/usr/local/bin/monday-source-test"]
