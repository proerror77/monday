# syntax=docker/dockerfile:1.7

FROM rust:1.91-bookworm AS builder

WORKDIR /work
ENV RUST_MIN_STACK=33554432
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    cmake \
    mold \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/work/target,sharing=locked \
    cargo --config 'build.rustc-wrapper=""' build \
    --release \
    --locked \
    -p hft-backtest \
    -p alpha-harness \
    && cargo --config 'build.rustc-wrapper=""' build \
    --release \
    --locked \
    -p hft-collector \
    --bin lob-pit-materializer \
    && CARGO_TARGET_DIR=/work/target/prediction-markets \
    cargo --config 'build.rustc-wrapper=""' build \
    --manifest-path prediction-markets/Cargo.toml \
    --release \
    --locked \
    -p ploy-research \
    --features db \
    --bin monday-prediction-research \
    --bin monday-prediction-evaluator \
    --bin monday-prediction-snapshot \
    && install -D -m 0755 /work/target/release/hft-backtest /out/bin/hft-backtest \
    && install -D -m 0755 /work/target/release/alpha-harness /out/bin/alpha-harness \
    && install -D -m 0755 /work/target/release/lob-pit-materializer /out/bin/lob-pit-materializer \
    && install -D -m 0755 /work/target/prediction-markets/release/monday-prediction-research /out/bin/monday-prediction-research \
    && install -D -m 0755 /work/target/prediction-markets/release/monday-prediction-evaluator /out/bin/monday-prediction-evaluator \
    && install -D -m 0755 /work/target/prediction-markets/release/monday-prediction-snapshot /out/bin/monday-prediction-snapshot \
    && for binary in monday-prediction-research monday-prediction-evaluator monday-prediction-snapshot; do \
        sha256sum "/out/bin/$binary" | awk '{print $1}' > "/out/bin/$binary.sha256"; \
    done

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tini \
    zstd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 research

COPY --from=builder /out/bin/hft-backtest /usr/local/bin/hft-backtest
COPY --from=builder /out/bin/alpha-harness /usr/local/bin/alpha-harness
COPY --from=builder /out/bin/lob-pit-materializer /usr/local/bin/lob-pit-materializer
COPY --from=builder /out/bin/monday-prediction-research /usr/local/bin/monday-prediction-research
COPY --from=builder /out/bin/monday-prediction-evaluator /usr/local/bin/monday-prediction-evaluator
COPY --from=builder /out/bin/monday-prediction-snapshot /usr/local/bin/monday-prediction-snapshot
COPY --from=builder /out/bin/monday-prediction-research.sha256 /usr/local/bin/monday-prediction-research.sha256
COPY --from=builder /out/bin/monday-prediction-evaluator.sha256 /usr/local/bin/monday-prediction-evaluator.sha256
COPY --from=builder /out/bin/monday-prediction-snapshot.sha256 /usr/local/bin/monday-prediction-snapshot.sha256

RUN mkdir -p /work/config /work/data /work/results \
    && chown -R research:research /work

USER research
WORKDIR /work
ENV ALPHA_HARNESS_BIN=/usr/local/bin/alpha-harness

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hft-backtest"]
