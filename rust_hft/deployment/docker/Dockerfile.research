# syntax=docker/dockerfile:1.7

FROM rust:1.98.1-bookworm AS builder

ARG SOURCE_REVISION
WORKDIR /work
ENV RUST_MIN_STACK=33554432
ENV CARGO_TARGET_DIR=/work/target
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    cmake \
    mold \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/work/target,sharing=locked \
    test "${#SOURCE_REVISION}" -eq 40 \
    && case "$SOURCE_REVISION" in *[!0-9a-f]*) exit 1 ;; esac \
    && MONDAY_SOURCE_REVISION="$SOURCE_REVISION" cargo --config 'build.rustc-wrapper=""' build \
    --manifest-path research-core/Cargo.toml \
    --release \
    --locked \
    -p hft-backtest \
    -p alpha-harness \
    && MONDAY_SOURCE_REVISION="$SOURCE_REVISION" cargo --config 'build.rustc-wrapper=""' build \
    --manifest-path research-core/Cargo.toml \
    --release \
    --locked \
    -p hft-cex-research-worker \
    --bin monday-cex-worker \
    && cargo --config 'build.rustc-wrapper=""' build \
    --manifest-path data-pipelines/Cargo.toml \
    --release \
    --locked \
    -p hft-collector \
    --bin lob-pit-materializer \
    --bin binance-market-tape-slicer \
    --bin binance-replay-parquet-materializer \
    --bin clickhouse-analytics-materializer \
    && install -D -m 0755 /work/target/release/hft-backtest /out/bin/hft-backtest \
    && install -D -m 0755 /work/target/release/alpha-harness /out/bin/alpha-harness \
    && install -D -m 0755 /work/target/release/monday-cex-worker /out/bin/monday-cex-worker \
    && install -D -m 0755 /work/target/release/lob-pit-materializer /out/bin/lob-pit-materializer \
    && install -D -m 0755 /work/target/release/binance-market-tape-slicer /out/bin/binance-market-tape-slicer \
    && install -D -m 0755 /work/target/release/binance-replay-parquet-materializer /out/bin/binance-replay-parquet-materializer \
    && install -D -m 0755 /work/target/release/clickhouse-analytics-materializer /out/bin/clickhouse-analytics-materializer

FROM debian:bookworm-slim AS runtime-base
ENV MONDAY_EXECUTION_HOST=ack

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tini \
    zstd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 research

RUN mkdir -p /work/config /work/data /work/results \
    && chown -R research:research /work

USER research
WORKDIR /work
ENV ALPHA_HARNESS_BIN=/usr/local/bin/alpha-harness

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hft-backtest"]

FROM runtime-base AS prebuilt

COPY --chmod=0755 research-bin/hft-backtest /usr/local/bin/hft-backtest
COPY --chmod=0755 research-bin/alpha-harness /usr/local/bin/alpha-harness
COPY --chmod=0755 research-bin/monday-cex-worker /usr/local/bin/monday-cex-worker
COPY --chmod=0755 research-bin/lob-pit-materializer /usr/local/bin/lob-pit-materializer
COPY --chmod=0755 research-bin/binance-market-tape-slicer /usr/local/bin/binance-market-tape-slicer
COPY --chmod=0755 research-bin/binance-replay-parquet-materializer /usr/local/bin/binance-replay-parquet-materializer
COPY --chmod=0755 research-bin/clickhouse-analytics-materializer /usr/local/bin/clickhouse-analytics-materializer

FROM runtime-base AS runtime

COPY --from=builder /out/bin/ /usr/local/bin/
