# Copy this file outside the repository, replace every placeholder, and pass the
# resulting path through HFT_K8S_SECRETS_FILE when deploying.
apiVersion: v1
kind: Secret
metadata:
  name: hft-secrets
  namespace: hft-trading
type: Opaque
stringData:
  redis-url: "CHANGE_ME_REDIS_URL"
  clickhouse-url: "CHANGE_ME_CLICKHOUSE_URL"
  clickhouse-user: "CHANGE_ME_CLICKHOUSE_USER"
  clickhouse-password: "CHANGE_ME_CLICKHOUSE_PASSWORD"
  grpc-auth-token: "CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS"
---
apiVersion: v1
kind: Secret
metadata:
  name: exchange-secrets
  namespace: hft-trading
type: Opaque
stringData:
  bitget-api-key: "CHANGE_ME_BITGET_API_KEY"
  bitget-api-secret: "CHANGE_ME_BITGET_API_SECRET"
  bitget-passphrase: "CHANGE_ME_BITGET_PASSPHRASE"
  binance-api-key: "CHANGE_ME_BINANCE_API_KEY"
  binance-api-secret: "CHANGE_ME_BINANCE_API_SECRET"
  bybit-api-key: "CHANGE_ME_BYBIT_API_KEY"
  bybit-api-secret: "CHANGE_ME_BYBIT_API_SECRET"
  hyperliquid-private-key: "CHANGE_ME_HYPERLIQUID_PRIVATE_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: alert-secrets
  namespace: hft-trading
type: Opaque
stringData:
  webhook-url: "CHANGE_ME_ALERT_WEBHOOK_URL"
  pagerduty-key: "CHANGE_ME_PAGERDUTY_KEY"
